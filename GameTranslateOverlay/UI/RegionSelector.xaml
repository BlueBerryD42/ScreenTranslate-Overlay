<Window x:Class="GameTranslateOverlay.UI.RegionSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        Focusable="True"
        Cursor="Cross">
    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Border x:Name="InstructionBanner"
                Background="#EE0A0A0B"
                BorderBrush="#5B8EF0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,4"
                Cursor="Arrow">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Compact Quick Switch Button (identical to Overlay HUD) -->
                <Button x:Name="LangSwitchButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="6,2"
                        Margin="0,0,8,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource HudAccentBrush}"
                        ToolTip="Click to change source/target language or swap"
                        Cursor="Hand"
                        Click="OnLangSwitchClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LangBadgeText" Text="JA &#x2192; EN-US" VerticalAlignment="Center" />
                        <TextBlock Text=" &#x25BE;" FontSize="8" Margin="3,0,0,0" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Separator divider -->
                <Rectangle Width="1" Height="14" Fill="#335B8EF0" Margin="0,0,8,0" />

                <!-- Action hints -->
                <TextBlock Text="Drag to select region  &#x2022;  Right-Click or Esc to cancel"
                           Foreground="#F5F5F7"
                           FontSize="11"
                           FontFamily="Segoe UI, Arial, sans-serif"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Outline of currently saved capture region (if available) -->
        <Rectangle x:Name="SavedRegionBox"
                   Stroke="#775B8EF0"
                   StrokeThickness="1.5"
                   StrokeDashArray="4 2"
                   Fill="#0C5B8EF0"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />
        <Border x:Name="SavedRegionLabel"
                Background="#CC0A0A0B"
                BorderBrush="#555B8EF0"
                BorderThickness="1"
                CornerRadius="3"
                Padding="6,1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock Text="Current Region" FontSize="10" Foreground="#88A0D0" FontWeight="SemiBold" />
        </Border>

        <Border x:Name="SelectionBox"
                BorderBrush="#5B8EF0"
                BorderThickness="2"
                Background="#335B8EF0"
                Visibility="Collapsed" />

        <Border x:Name="DimensionBadge"
                Background="#EE0A0A0B"
                BorderBrush="#5B8EF0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6,3"
                Visibility="Collapsed">
            <TextBlock x:Name="DimensionText"
                       Text="0 &#xd7; 0 px"
                       Foreground="#F5F5F7"
                       FontSize="11"
                       FontFamily="Cascadia Mono, Consolas, monospace" />
        </Border>
    </Canvas>
</Window>
