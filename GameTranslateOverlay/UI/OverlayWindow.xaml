<Window x:Class="GameTranslateOverlay.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameTranslateOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxHeight="380">
    <Border x:Name="PillBorder"
            Style="{StaticResource HudPillBorder}"
            MinWidth="280"
            MaxWidth="640"
            MouseEnter="OnOverlayMouseEnter"
            MouseLeave="OnOverlayMouseLeave">
        <StackPanel>
            <DockPanel Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="OrigButton"
                                  Content="Orig"
                                  Style="{StaticResource SecondaryToggleButtonStyle}"
                                  Padding="6,2"
                                  Margin="0,0,4,0"
                                  FontSize="10"
                                  ToolTip="Toggle original detected text"
                                  Click="OnOrigToggleClick" />
                    <Button x:Name="CopyButton"
                            Content="Copy"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="6,2"
                            Margin="0,0,4,0"
                            FontSize="10"
                            Click="OnCopyClick" />
                    <ToggleButton x:Name="KeepButton"
                                  Content="Keep"
                                  Style="{StaticResource SecondaryToggleButtonStyle}"
                                  Padding="6,2"
                                  Margin="0,0,4,0"
                                  FontSize="10"
                                  ToolTip="Keep visible — pauses auto-hide until turned off or app restarts"
                                  Click="OnKeepClick" />
                    <Button x:Name="CloseButton"
                            Content="×"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,2"
                            MinWidth="24"
                            FontSize="12"
                            FontWeight="SemiBold"
                            ToolTip="Close"
                            Click="OnCloseClick" />
                </StackPanel>
                <Border x:Name="DragHandle"
                        DockPanel.Dock="Left"
                        Height="18"
                        MinWidth="24"
                        Margin="0,0,6,0"
                        Background="Transparent"
                        Cursor="SizeAll"
                        ToolTip="Drag to move"
                        MouseLeftButtonDown="OnDragHandleDown">
                    <TextBlock Text="&#x22EE;&#x22EE;"
                               FontSize="10"
                               Foreground="{StaticResource HudMutedBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Border>
                <Button x:Name="LangSwitchButton"
                        DockPanel.Dock="Left"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="6,2"
                        Margin="0,0,6,0"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource HudAccentBrush}"
                        ToolTip="Quick switch target or source language"
                        Click="OnLangSwitchClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LangBadgeText" Text="JA &#x2192; EN" />
                        <TextBlock Text=" &#x25BE;" FontSize="8" Margin="2,0,0,0" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ProgressBar x:Name="LoadingBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Auto-hide countdown depletion bar -->
            <ProgressBar x:Name="AutoHideProgress"
                         Height="2"
                         Minimum="0"
                         Maximum="100"
                         Value="100"
                         Foreground="{StaticResource HudAccentBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,0,0,4"
                         Visibility="Collapsed" />

            <ScrollViewer x:Name="ContentScrollViewer"
                          MaxHeight="300"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel>
                    <TextBlock x:Name="SourceText"
                               Text=""
                               TextWrapping="Wrap"
                               Foreground="{StaticResource HudMutedBrush}"
                               FontSize="10"
                               Margin="0,0,0,4"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="TranslationText"
                               Text=""
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="12"
                               LineHeight="18" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
